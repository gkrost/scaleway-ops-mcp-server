{
  "name": "scaleway-ops-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Scaleway IAM (Applications, API keys, Policies, Permission sets) and Object Storage (buckets, Bucket Policies, object CRUD)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "scaleway-ops-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsc --watch",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "scaleway",
    "iam",
    "object-storage",
    "bucket-policy",
    "devops"
  ],
  "author": "Gernot Krost <gernot@krost.org>",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "^3.1112.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
